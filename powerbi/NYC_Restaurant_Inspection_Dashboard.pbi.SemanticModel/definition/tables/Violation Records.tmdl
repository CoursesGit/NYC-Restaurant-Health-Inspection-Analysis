	column 'Violation Month Date' =
			
			IF(
			    ISBLANK('Violation Records'[INSPECTION DATE]),
			    BLANK(),
			    DATE(
			        YEAR('Violation Records'[INSPECTION DATE]),
			        MONTH('Violation Records'[INSPECTION DATE]),
			        1
			    )
			)
		formatString: General Date
		lineageTag: fa19e6d8-45ef-4a88-bea0-9ab19ed93e3b
		summarizeBy: none

		variation Variation
			isDefault
			relationship: 83204a0f-c04a-4c3a-b298-5d44db8938f5
			defaultHierarchy: LocalDateTable_3080a2de-ec88-470f-81aa-99b317a9e409.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column 'Risk Area' =
			
			IF(
			    ISBLANK('Violation Records'[BORO])
			        || ISBLANK('Violation Records'[NTA]),
			    BLANK(),
			    'Violation Records'[BORO]
			        & " - "
			        & 'Violation Records'[NTA]
			)
		lineageTag: 7281d8ed-e5e4-4596-8625-c50de2c3eced
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'Violation Records' = m
