table 'Violation Records'
	lineageTag: 6428a7a5-c048-4f5c-8022-890d0aeda95b

	measure 'Violation Record Count' =
			CALCULATE(
			    COUNTROWS('Violation Records'),
			    'Violation Records'[VIOLATION CODE] <> BLANK()
			)
		formatString: 0
		lineageTag: 3a8f6fd5-43c2-492d-a376-5d7bc2d64d04

	measure 'Critical Violations' =
			CALCULATE(
			    COUNTROWS('Violation Records'),
			    'Violation Records'[VIOLATION CODE] <> BLANK(),
			    'Violation Records'[CRITICAL FLAG] = "Critical"
			)
		formatString: 0
		lineageTag: 0687ae61-69f4-4d8e-9b7e-3cac7ba02e3a

	measure 'Valid Critical Flag Records' =
			CALCULATE(
			    COUNTROWS('Violation Records'),
			    'Violation Records'[VIOLATION CODE] <> BLANK(),
			    'Violation Records'[CRITICAL FLAG] IN {"Critical", "Not Critical"}
			)
		formatString: 0
		lineageTag: 4ad9f4aa-3ec6-4b31-983b-1b19960b2987

	measure 'Critical Violation Rate' =
			DIVIDE(
			    [Critical Violations],
			    [Valid Critical Flag Records]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 979e1008-ae4e-4f32-855f-774e46c7fa7a

